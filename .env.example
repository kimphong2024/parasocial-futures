# --- core ---
PORT=8080
STATE_DB=./data/state.db            # Railway: /data/state.db
APP_PASSWORD=                        # unset = auth off (local dev)
SESSION_SECRET=change-me
NODE_ENV=development

# --- AI ---
ANTHROPIC_API_KEY=                   # chat, scenario drafting, scan classification
LLM_MODEL=claude-opus-4-8

# --- embeddings / RAG ---
VOYAGE_API_KEY=                      # semantic search, dedup, chat retrieval
VOYAGE_MODEL=voyage-3.5

# --- scanning ---
PERPLEXITY_API_KEY=                  # broad undirected weekly-recency scans
FIRECRAWL_API_KEY=                   # directed source crawls
DEDUP_THRESHOLD=0.90

# --- scheduler (Railway sets ENABLE_CRON=1; local stays off) ---
ENABLE_CRON=0
REFRESH_HOUR=22
REFRESH_TZ=Asia/Singapore
